# REST + websocket indexer (apps/indexer). Leave empty to run in mock mode.
NEXT_PUBLIC_API_URL=
# Force mock mode on (1) or off (0). Defaults to 1 when NEXT_PUBLIC_API_URL is empty.
NEXT_PUBLIC_MOCK=
# Solana RPC used for on-chain reads, simulation and sending. Defaults to devnet.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Cluster for explorer links: devnet | mainnet-beta | testnet. Inferred from the RPC URL when empty.
NEXT_PUBLIC_CLUSTER=
# Optional upload endpoint for coin images and metadata JSON (POST multipart, returns {"url": "..."}).
NEXT_PUBLIC_UPLOAD_URL=
# Demo coin replayed on /challenge (live mode): FLRD "Floored Demo" on devnet.
NEXT_PUBLIC_CHALLENGE_MINT=7PwqFN6yrgWQDim5RFR4au4znTbr2NBGH6ND1JQgFVYY
# Its "dev" wallet, the one that dumps its bag during the challenge.
NEXT_PUBLIC_CHALLENGE_DEV=5rA2GzrTpitKbeeuK9EPzvZR1TaCGZ5feZ2PhJmJ7evE
# Public site origin, used for OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Data source ----
# mock | indexer | chain. Inferred when empty: mock without an API URL, indexer with one.
# "chain": no indexer; the site's own /api route handlers read the program through the server RPC.
NEXT_PUBLIC_DATA=
# Server-only RPC (a private Helius key for example) used by the /api route handlers, the /api/rpc proxy
# and server-side reads. Never NEXT_PUBLIC_. With NEXT_PUBLIC_RPC_URL=/api/rpc the browser only ever sees the proxy.
UPSTREAM_RPC_URL=
# Links in the footer / header.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# ── launch prep (docs/LAUNCH.md) ──
# Vercel Blob read-write token: set automatically when a Blob store is linked to the project. Enables /api/upload.
BLOB_READ_WRITE_TOKEN=
# Cron backstop (/api/cron/crank, every 5 minutes on Vercel): the bearer secret Vercel sends, and the crank wallet (JSON byte array).
CRON_SECRET=
CRANK_KEYPAIR=
# Optional: RPC the rug-proof challenge reads (the demo episode lives on devnet). Unset: the site's RPC on devnet, public devnet otherwise.
NEXT_PUBLIC_CHALLENGE_RPC_URL=
