# REST + websocket indexer (apps/indexer). Leave empty to run in mock mode.
NEXT_PUBLIC_API_URL=
# Force mock mode on (1) or off (0). Defaults to 1 when NEXT_PUBLIC_API_URL is empty.
NEXT_PUBLIC_MOCK=
# Solana RPC used for on-chain reads, simulation and sending. Defaults to devnet.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Cluster for explorer links: devnet | mainnet-beta | testnet. Inferred from the RPC URL when empty.
NEXT_PUBLIC_CLUSTER=
# Optional upload endpoint for coin images and metadata JSON (POST multipart, returns {"url": "..."}).
NEXT_PUBLIC_UPLOAD_URL=
# Demo coin replayed on /challenge (live mode): FLRD "Floored Demo" on devnet.
NEXT_PUBLIC_CHALLENGE_MINT=7PwqFN6yrgWQDim5RFR4au4znTbr2NBGH6ND1JQgFVYY
# Its "dev" wallet, the one that dumps its bag during the challenge.
NEXT_PUBLIC_CHALLENGE_DEV=5rA2GzrTpitKbeeuK9EPzvZR1TaCGZ5feZ2PhJmJ7evE
# Public site origin, used for OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
